# Keep the actual .env file out of source control.
OPENAI_API_KEY=
FAL_KEY=
# Optional local FFmpeg executable override; the container already includes FFmpeg.
FFMPEG_PATH=ffmpeg
HOST=127.0.0.1
PORT=8787
DATA_DIRECTORY=data
APPLE_BUNDLE_ID=com.gregadams.myfurbaby
APPLE_ENVIRONMENT=Sandbox
# Comma-separated absolute paths to Apple's root CA certificates from https://www.apple.com/certificateauthority/
APPLE_ROOT_CA_PATHS=
# Required for Production purchase verification; numeric App Store app ID.
APPLE_APP_ID=
TRUST_RAILWAY_PROXY=false
